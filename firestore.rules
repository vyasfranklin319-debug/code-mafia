rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Profiles ─────────────────────────────────────────
    // Users can read any profile (for leaderboard display),
    // but can only write their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Game Sessions (Lobby State) ───────────────────────────
    // Any authenticated user can read a session (to join).
    // Only the host (creator) can update session config.
    // Players can update to add themselves or toggle ready state.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.token.email != null;
    }

    // ── Match History ─────────────────────────────────────────
    // Authenticated users can read all history (for leaderboard).
    // Only write their own match records.
    match /matchHistory/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Leaderboard ───────────────────────────────────────────
    // Publicly readable (shown on landing page), auth required to write.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Room Chat Messages ────────────────────────────────────
    // Auth required for both read and write.
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Deny all other documents by default ───────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
