{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "code-mafia-api",
	"main": "src/index.js",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"FIREBASE_PROJECT_ID": "codemafia-54284"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_ROOM",
				"class_name": "GameRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GameRoom"]
		}
	]
}